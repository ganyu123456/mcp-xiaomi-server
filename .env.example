# Harbor 镜像地址 (在线部署，默认已指向 harbor.zkjgy.online/library，无需修改)
# MCP_IMAGE=harbor.zkjgy.online/library/mcp-xiaomi-server:latest

# 离线部署使用本地镜像
# docker load -i mcp-xiaomi-server_v1.0.0_linux-amd64.tar.gz
# MCP_IMAGE=mcp-xiaomi-server:v1.0.0

# Server port (SSE mode)
MCP_PORT=8092

# Transport mode: stdio or sse
MCP_TRANSPORT=sse

# 设备清单配置文件路径 (JSON)，见 devices.example.json
MCP_XIAOMI_DEVICES=/app/config/devices.json

# 单次设备通信超时 (秒)
MCP_XIAOMI_TIMEOUT=5

# 摄像头抓拍/录制用的 ffmpeg 路径(容器内已内置,一般无需修改)
MCP_XIAOMI_FFMPEG=ffmpeg

# 摄像头录制 MP4 的保存目录(默认系统临时目录)
# MCP_XIAOMI_CLIP_DIR=/app/config/clips

# Server version (used in labels)
MCP_VERSION=latest
